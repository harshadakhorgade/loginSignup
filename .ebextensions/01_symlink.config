files:
  "/opt/elasticbeanstalk/hooks/appdeploy/pre/01_create_current_symlink.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Create /var/app/current as a symlink to /var/app/staging if it doesn't exist
      if [ ! -d /var/app/current ]; then
        ln -s /var/app/staging /var/app/current
      fi
